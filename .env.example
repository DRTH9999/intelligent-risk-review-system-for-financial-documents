# 财务单据智能风险审核系统 - 环境变量示例
#
# 使用方式：复制为项目根目录的 .env，按需修改后重启服务。
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# 已存在的进程环境变量优先级高于 .env 中的同名配置。

# ---------------------------------------------------------------- 存储与数据库
# 数据目录：SQLite 数据库与导出报告，默认 ./data
RISK_REVIEW_DATA_DIR=./data
# 附件存储目录，默认 ./storage（附件保存在 storage/attachments）
RISK_REVIEW_STORAGE_DIR=./storage
# 数据库连接串；留空时自动使用 <数据目录>/risk_review.db
# RISK_REVIEW_DATABASE_URL=sqlite:///./data/risk_review.db

# ---------------------------------------------------------------- 认证与安全
# JWT 签名密钥：生产环境必须替换为随机长字符串（如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
RISK_REVIEW_SECRET_KEY=risk-review-dev-secret-key-change-in-production
# 访问令牌有效期（分钟），默认 480（8 小时）
RISK_REVIEW_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------- 服务
# 监听端口（run.py 使用），默认 8000
PORT=8000

# 后台任务：固定一个调度器，工作进程从数据库读取待处理任务。
RISK_REVIEW_WORKER_ENABLED=true
# 单次解析或分析的最长运行秒数；超时会停止该工作进程并保存失败状态。
RISK_REVIEW_TASK_TIMEOUT=180

# ---------------------------------------------------------------- 其他说明
# 附件上传限制为 15MB，允许 PDF / PNG / JPG，目前在 app/config.py 中固定配置。
# 生产部署建议同时设置 HTTPS 反向代理，并将 SECRET_KEY 改为真实随机值。
